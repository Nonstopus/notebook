QTreeWidget {
    background: #F3F6FA;
    border: 1px solid #CED6E0;
    border-radius: 8px;
    outline: 0;
    padding: 6px;
}

QTreeWidget::item {
    margin: 6px 0;
    border-radius: 8px;
    background: transparent;
}

QTreeWidget::item:hover {
    background: #F7F9FC;
}

QTreeWidget::item:selected {
    background: #E8EDF3;
    color: #1C232B;
    border: 1px solid #5A6B7D;
}

QTreeWidget::item:selected:active,
QTreeWidget::item:selected:!active {
    background: #E8EDF3;
    color: #1C232B;
    border: 1px solid #5A6B7D;
}

QTreeWidget:focus {
    border: 1px solid #5A6B7D;
}
